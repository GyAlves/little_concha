	"version": "0.2.0",
	"configurations": [
		{
			"name": "(gdb) Launch",
			"type": "cppdbg",
			"request": "launch",
			"program": "/mnt/c/Users/fabio/Documents/commoncore/little_concha/minishell",
			"args": [],
			"stopAtEntry": true,
			"cwd": "/mnt/c/Users/fabio/Documents/commoncore/little_concha/",
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				},
				{
					"description": "Interupt SIGINT",
					"text": "-exec handle SIGINT nostop noprint pass",
					"ignoreFailures": true
				}
			]
		}

	]
}